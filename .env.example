# LocalConnect PostgreSQL environment template
# Copy this file to .env for local development.
# NEVER commit real secrets or upload a real .env to a public repository.

APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:5000
APP_BASE_PATH=/

# Generate a long random value (at least 32 bytes) for production.
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY
# APP_KEY=REPLACE_ONLY_IF_NEEDED_FOR_LEGACY_MFA_DATA

# PostgreSQL
# Render: paste the Internal Database URL provided by your Render PostgreSQL database.
# Local example:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/localconnect_db
# The application automatically normalizes this to postgresql+psycopg.

# Optional DB_* fallback when DATABASE_URL is not used.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=localconnect_db
# DB_USER=postgres
# DB_PASSWORD=YOUR_PASSWORD
# DB_SSL=false
# DB_SSLMODE=require
# DB_CONNECT_TIMEOUT=10
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=280

SESSION_NAME=localconnect_session
SESSION_COOKIE_SECURE=false
FORCE_HTTPS=false
APP_ADMIN_MFA_REQUIRED=true
APP_REQUIRE_EMAIL_VERIFICATION=true
UPLOAD_REQUIRE_REENCODE=true

UPLOAD_STORAGE_BACKEND=filesystem
UPLOAD_STORAGE_ROOT=./uploads
UPLOAD_DISK_REQUIRED=false

# Mail
APP_MAIL_DRIVER=smtp
APP_MAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_USE_TLS=true

# Host/security
TRUSTED_HOSTS=127.0.0.1,localhost
TRUST_PROXY=false
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_HOPS=1
SECURITY_CSP_MODE=enforce
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Payments
PAYMENT_ALLOW_LIVE=false
PAYMENT_RAZORPAY_KEY_ID=
PAYMENT_RAZORPAY_KEY_SECRET=
PAYMENT_RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RAZORPAY_WEBHOOK_IP_ALLOWLIST=

# Optional performance/limits
PERF_METRICS_ENABLED=false
STATIC_CACHE_SECONDS=3600
